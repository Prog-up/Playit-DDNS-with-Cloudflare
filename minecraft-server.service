[Unit]
Description=Minecraft Server - Create Chronicles Bosses and Beyond
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/srv/minecraft

ExecStart=/usr/bin/java @user_jvm_args.txt @libraries/net/minecraftforge/forge/1.20.1-47.2.20/unix_args.txt nogui

# Graceful shutdown with SIGTERM (Forge catches SIGTERM to save worlds)
KillSignal=SIGTERM
TimeoutStopSec=90
TimeoutStartSec=300

Restart=on-failure
RestartSec=30

LimitNOFILE=65536
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
